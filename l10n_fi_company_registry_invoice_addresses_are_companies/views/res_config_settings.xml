<?xml version="1.0" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.invoice.address.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="contacts_setting_container" position="inside">
                <setting
                    id="mark_invoice_addresses_as_company"
                    string="Invoice Addresses with Company ID"
                    help="Mark existing invoice addresses that have their own Company ID as companies"
                >
                    <button
                        name="action_mark_invoice_addresses_as_company"
                        type="object"
                        string="Mark as Companies"
                        icon="oi-arrow-right"
                        class="btn-link"
                        confirm="All invoice addresses that have their own Company ID will be marked as companies. Continue?"
                    />
                </setting>
            </block>
        </field>
    </record>
</odoo>
